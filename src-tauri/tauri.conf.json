{
  "productName": "CIA RENDER",
  "version": "1.0.0",
  "identifier": "com.ciarender.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local video interpolation and rendering.",
    "longDescription": "CIA RENDER is a local desktop workflow for RIFE interpolation and smoothie-rs rendering. Smoothie and media tools are included; the optional RIFE environment is installed only when requested.",
    "resources": [
      "resources/time_remap.py",
      "resources/runtime",
      "resources/bootstrap/bootstrap-rife.ps1",
      "resources/bootstrap/python-3.11.9-amd64.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "CIA RENDER",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CIA RENDER",
        "width": 920,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  }
}
