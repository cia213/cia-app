{
  "productName": "cia render",
  "version": "1.3.0",
  "identifier": "io.github.cia213.ciaapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local video interpolation and rendering.",
    "longDescription": "cia render is a local desktop workflow for RIFE interpolation and smoothie-rs rendering. Smoothie and media tools are included; the optional RIFE environment is installed only when requested.",
    "resources": [
      "resources/time_remap.py",
      "resources/rife_worker.py",
      "resources/runtime_health.py",
      "resources/runtime",
      "resources/bootstrap/bootstrap-rife.ps1",
      "resources/bootstrap/bootstrap-python.ps1",
      "resources/bootstrap/rife-profile.json",
      "resources/bootstrap/rife-requirements.lock"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "cia render",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwREI5RTEwM0VEQTM2QzQKUldURU50bytFSjdiSURuejUrUjJ1N2JOMjJxS1pMYzBKN1JmN003YUhQaFU4MDNGT3dHcVVMVXYK",
      "endpoints": [
        "https://github.com/cia213/cia-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cia render",
        "width": 920,
        "height": 540,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 440,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  }
}
