{
  "productName": "TimeRemap",
  "version": "0.1.0",
  "identifier": "com.timeremap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeRemap",
        "width": 920,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  }
}
